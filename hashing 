package hashing;
import java.util.Scanner;
public class HashingChainingDemo 
{

      class Node
      {
          int data;
          Node link;

          Node(int data) 
          {
              this.data = data;
              this.link = null;
          }
      }

      Node table[];
      int size;

      HashingChainingDemo(int size) {
          this.size = size;
          table = new Node[size];
          for(int i=0;i<size;i++)
          {
            table[i]=null;
          }
      }

      int hashFunction(int key) {
          return key % size;
      }

      void insert(int key) {
          int index = hashFunction(key);
          Node t = new Node(key);

          if (table[index] == null) {
              table[index] = t;
          } else {
              Node temp = table[index];
              while (temp.link != null) {
                  temp = temp.link;
              }
              temp.link = t;
          }

          System.out.println("Element inserted at index " + index);
      }

      void search(int key) {
          int index = hashFunction(key);
          Node temp = table[index];

          while (temp != null) {
              if (temp.data == key) {
                  System.out.println("Element found at index " + index);
                  return;
              }
              temp = temp.link;
          }

          System.out.println("Element not found");
      }

      void display() {
          for (int i = 0; i < size; i++) {
              System.out.print(i + " : ");
              Node temp = table[i];

              while (temp != null) {
                  System.out.print(temp.data + " -> ");
                  temp = temp.link;
              }
              System.out.println("null");
          }
      }

      public static void main(String args[]) 
      {
          Scanner sc = new Scanner(System.in);

          System.out.print("Enter hash table size: ");
          int size = sc.nextInt();

          HashingChainingDemo hc = new HashingChainingDemo(size);

          int choice, key;

          do {
              System.out.println("\n---- HASHING WITH CHAINING ----");
              System.out.println("1. Insert");
              System.out.println("2. Search");
              System.out.println("3. Display");
              System.out.println("4. Exit");
              System.out.print("Enter your choice: ");

              choice = sc.nextInt();

              switch (choice) {

                  case 1:
                      System.out.print("Enter element to insert: ");
                      key = sc.nextInt();
                      hc.insert(key);
                      break;

                  case 2:
                      System.out.print("Enter element to search: ");
                      key = sc.nextInt();
                      hc.search(key);
                      break;

                  case 3:
                      hc.display();
                      break;

                  case 4:
                      System.out.println("Exiting program...");
                      break;

                  default:
                      System.out.println("Invalid choice");
              }

          } while (choice != 4);
      }
  }